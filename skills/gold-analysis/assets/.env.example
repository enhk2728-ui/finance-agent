# ============================================================
# Gold Analysis Skill Configuration
# Copy this to .env (in the skill root or your working directory)
# and fill in your values.
# ============================================================

# Agent's LLM provider is configured in your Claude Code settings
# (ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL in settings.json).
# This skill uses the agent's own model for analysis — no separate
# API key needed.

# --- Data Source ---
# GOLD_MT5_SYMBOL=XAUUSD
# Override the default symbol (XAUUSD). Uncomment to change.

# --- Knowledge Base (additional source material) ---
# GOLD_KNOWLEDGE_DIR=
# Optional: path to additional Al Brooks book files or supplementary trading references.
# If not set, only the built-in 7 reference files in references/ are used.

# --- Analysis Parameters ---
# GOLD_LOOKBACK_DAYS=3
# Days of M5 data to analyze (default 3). Uncomment to override.

# GOLD_CACHE_STALE_SECONDS=300
# Data cache staleness in seconds (default 300 = 5 minutes).
